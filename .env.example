# -------------------------------------------------------------------
# I'M HERE — environment configuration
# Copy this file to `.env` and fill in your real Supabase project values.
# NEVER commit `.env`. NEVER put the service_role key in here or in any
# frontend code — only the publishable/anon key belongs in the browser.
# -------------------------------------------------------------------

# Found in: Supabase Dashboard > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Found in: Supabase Dashboard > Project Settings > API > Project API keys > anon / publishable
# This key is safe in the browser ONLY because Row Level Security (RLS) is enabled
# on every table (see supabase/schema.sql).
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
